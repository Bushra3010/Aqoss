# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# ---- Platform ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform domain. Every hotel website is served at <website-slug>.<this domain>:
#   dev:        the-serenity-inn-goa.localhost:3000   (NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000)
#   production: the-serenity-inn-goa.aqoss.com        (NEXT_PUBLIC_ROOT_DOMAIN=aqoss.com,
#               NEXT_PUBLIC_APP_URL=https://aqoss.com, plus a wildcard DNS record *.aqoss.com)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Hostname that serves the CRM (admin) app
NEXT_PUBLIC_ADMIN_HOST=admin.localhost:3000
# Fallback website slug used when a hostname cannot be resolved (dev convenience)
DEFAULT_WEBSITE_SLUG=

# ---- Payments (adapter: mock | razorpay | stripe) ----
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Notifications (adapter: console | resend | smtp) ----
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="AQOSS Hotels <bookings@example.com>"
SMS_PROVIDER=console
SMS_API_KEY=
WHATSAPP_PROVIDER=console
WHATSAPP_API_KEY=

# ---- Booking engine ----
# Minutes a room is held while the customer pays
BOOKING_HOLD_MINUTES=15
